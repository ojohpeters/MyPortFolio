# Secret for /admin/thumbnails and the /api/thumbnails upload endpoints.
# Generate one with: openssl rand -hex 32
THUMBNAIL_ADMIN_TOKEN=

# Vercel Blob read/write token (created automatically when you connect a Blob
# store to the project in the Vercel dashboard). Without it, thumbnails are
# stored on local disk in .data/thumbnails — fine for development only.
BLOB_READ_WRITE_TOKEN=
